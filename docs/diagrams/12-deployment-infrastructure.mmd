%% DocPilot - Deployment and infrastructure as evidenced by compose.yaml, Makefile, config
%% Only a development topology exists in the repository. No production deployment config was found.
flowchart TB
    dev["Developer machine / host OS<br/>make dev orchestrates everything below"]

    subgraph host["Host processes (not containerized, no Dockerfile in repo)"]
        vite["Vite dev server<br/>make dev: 127.0.0.1:5173<br/>(vite.config default: PORT or 8443)<br/>proxies /api -> http://127.0.0.1:8000"]
        uv["uvicorn app.main:app --reload<br/>127.0.0.1:8000<br/>runs: FastAPI routers,<br/>BackgroundTasks ingestion,<br/>BGE-M3 via FlagEmbedding / PyTorch,<br/>LocalStorage"]
        fsd[("data/storage<br/>STORAGE_PATH, default under project root")]
        models[("BGE-M3 weights<br/>Hugging Face cache<br/>location not configured by repo")]
    end

    subgraph compose["Docker Compose (compose.yaml)"]
        pgc["postgres<br/>image pgvector/pgvector:pg17<br/>host 5433 -> container 5432<br/>named volume docpilot_postgres_data<br/>healthcheck pg_isready<br/>dev credentials in file"]
        llc["llama-server (optional in make dev)<br/>image ghcr.io/ggml-org/llama.cpp:server-cuda<br/>host 3000 -> container 8080<br/>model ggml-org/Qwen3-1.7B-GGUF Q4_K_M via -hf<br/>alias docpilot-qwen3-1.7b, ctx 4096, ngl 99<br/>NVIDIA GPU reservation, restart unless-stopped<br/>cache bind mount ./data/models/llama.cpp"]
    end

    cfg["Configuration<br/>.env at project root read by pydantic-settings<br/>required: DATABASE_URL, JWT_SECRET_KEY<br/>optional: STORAGE_PATH, LLM_BASE_URL (default http://127.0.0.1:3000/v1),<br/>LLM_API_KEY, LLM_MODEL, LLM_TIMEOUT_SECONDS,<br/>ACCESS_TOKEN_EXPIRE_MINUTES, APP_NAME, ENVIRONMENT, DEBUG"]
    alem["Alembic migrations<br/>make migrate: uv run alembic upgrade head<br/>manual step, not run at app startup"]

    hf["Hugging Face Hub (external)<br/>UNVERIFIED but implied for model downloads"]
    browser["Browser"]

    dev --> vite
    dev --> uv
    dev --> pgc
    dev --> llc
    browser -->|"http://127.0.0.1:5173"| vite
    vite -->|"HTTP proxy"| uv
    uv -->|"postgresql+asyncpg localhost:5433"| pgc
    uv -->|"file I/O"| fsd
    uv -->|"HTTP localhost:3000/v1"| llc
    uv --- models
    llc -.->|"first start"| hf
    models -.->|"first use"| hf
    cfg -.-> uv
    alem -.->|"schema"| pgc

    absent["NOT PRESENT: Dockerfiles for backend or frontend, reverse proxy / TLS,<br/>production compose or Kubernetes manifests, object storage service,<br/>separate vector DB (vectors live in Postgres), job queue / worker process,<br/>CORS configuration, CI/CD configuration (no .github directory in the archive)"]
    compose ~~~ absent
    classDef note fill:#fff,stroke:#999,stroke-dasharray: 4 4,color:#555
    class absent,hf note
