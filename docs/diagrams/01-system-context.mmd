        fs[("Local filesystem<br/>data/storage<br/>original uploaded files")]
    end

    llm["llama.cpp server (CUDA image)<br/>OpenAI-compatible /v1/chat/completions<br/>model: Qwen3-8B Q4_K_M GGUF<br/>loaded from ./data/local_models<br/>provisioned in compose.yaml"]
