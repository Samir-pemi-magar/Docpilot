    member -->|"HTTP, JWT bearer"| spa
    admin -->|"HTTP, JWT bearer"| spa
    spa -->|"REST via /api proxy"| api
    api -->|"SQL over asyncpg"| db
    api -->|"read/write files"| fs
    api -->|"HTTP JSON<br/>adaptive thinking mode"| llm
    api -.->|"BGE-M3 weights download"| hf
    api -.->|"configurable"| other

    notimpl["Not implemented:<br/>general-purpose SSO, email invitations,<br/>external object storage,<br/>separate vector database,<br/>separate worker/queue, streaming responses.<br/>Gmail OAuth is implemented for read-only access."]
