flowchart LR
    member["Organization member<br/>role: member<br/>read docs, search, chat,<br/>conversations, evaluations"]
    admin["Organization admin / owner<br/>upload and delete documents,<br/>manage members"]

    subgraph docpilot["DocPilot system boundary"]
        spa["Web UI<br/>React 19 + Vite SPA<br/>chat, conversation history,<br/>file manager, eval dashboard"]
