%% DocPilot - Document ingestion pipeline
%% ingestion_status values (DB check constraint): pending, processing, completed, failed
%% Changes vs. previous version: DOCX tables ARE extracted; XLSX uses saved formula results;
%% Gmail imports are a second entry point into the same create_document + ingestion task.
flowchart TD
    up["POST /organizations/{org}/documents<br/>or POST .../documents/{id}/versions<br/>requires role owner or admin<br/>multipart: name + file"]
    chk{"filename present?"}
    err400["400 A filename is required"]
    gmup["POST .../gmail/messages/ID/import (owner or admin)<br/>email text saved as gmail-UUID.txt,<br/>supported attachments saved under their own names<br/>(see diagram 16)"]

    subgraph sync["Synchronous part (inside the HTTP request)"]
        direction TB
        meta["calculate_file_metadata<br/>size_bytes + SHA-256"]
        doc["new document: INSERT documents, flush<br/>new version: lock document row FOR UPDATE,<br/>version_number = latest + 1"]
        save["storage.save<br/>key: organizations/ORG/documents/DOC/<br/>versions/N/original.EXT"]
        ver["INSERT document_versions<br/>ingestion_status = pending<br/>commit"]
        cleanup["on commit failure:<br/>rollback and best-effort<br/>storage.delete"]
        meta --> doc --> save --> ver
        ver -.->|"failure"| cleanup
    end

    resp["201 response<br/>ingestion_status = pending"]
    bgq["background_tasks.add_task<br/>process_document_version_background"]

    subgraph async["Background part (same process, own DB session)"]
        direction TB
        proc1["set status = processing, commit"]
        open["open file from StorageService"]
        parse{"ParserRegistry<br/>by file extension"}
        unsupp["UnsupportedDocumentTypeError"]
        pdf["PDF: PyMuPDF per page<br/>find_tables + text blocks outside tables<br/>table title from 'Table N' header or nearby short heading<br/>no OCR code present"]
        docx["DOCX: python-docx, body walked in order<br/>headings, paragraphs AND tables<br/>(rows joined with ' | ', title = 'Table N' cell<br/>or last heading)"]
        xlsx["XLSX: openpyxl, two passes<br/>formulas + saved results (data_only)<br/>saved value indexed; empty formula results skipped"]
        txt["TXT / MD / MARKDOWN"]
        ext["ExtractedDocument"]
        norm["NormalizerRegistry by source_type<br/>-> NormalizedDocument<br/>heading, paragraph, table, key_value<br/>(XLSX: dense cell regions -> table / key_value)"]
        chunk["HybridChunker<br/>prose runs -> ProseChunker<br/>table/key_value runs -> StructuredChunker<br/>(rows kept whole, header repeated per chunk,<br/>Worksheet / Table / Page prefix added)<br/>500 target / 800 max / 75 overlap<br/>whitespace token counter"]
        embed["embed_documents in threadpool<br/>BAAI/bge-m3, dense 1024-d<br/>batch size up to 8, max_length 1024"]
        lock["lock document_versions row FOR UPDATE"]
        persist["one transaction:<br/>DELETE existing chunks of version<br/>INSERT chunks<br/>INSERT chunk_embeddings<br/>status = completed"]
        fail["any exception: rollback<br/>status = failed<br/>logged, no retry"]

        proc1 --> open --> parse
        parse -->|".pdf"| pdf
        parse -->|".docx"| docx
        parse -->|".xlsx"| xlsx
        parse -->|".txt .md .markdown"| txt
        parse -->|"other"| unsupp
        pdf --> ext
        docx --> ext
        xlsx --> ext
        txt --> ext
        ext --> norm --> chunk --> embed --> lock --> persist
        unsupp --> fail
        embed -.->|"error"| fail
        persist -.->|"error"| fail
    end

    up --> chk
    chk -->|"no"| err400
    chk -->|"yes"| sync
    gmup -->|"same create_document, same background ingestion task"| sync
    sync --> resp
    sync --> bgq --> async

    note1["Upload accepts any file type.<br/>Unsupported types are only rejected<br/>later, as ingestion_status = failed.<br/>No startup recovery of versions<br/>stuck in processing was found.<br/>The UI does not display ingestion_status."]
    async ~~~ note1
    classDef note fill:#fff,stroke:#999,stroke-dasharray: 4 4,color:#555
    class note1 note
