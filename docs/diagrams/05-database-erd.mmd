%% DocPilot - Database ER diagram
%% Re-verified against backend/app/models/*.py and alembic/versions: 17 tables, Alembic head a7c19d4e2b61.
%% Gmail tables (gmail_connections, gmail_oauth_states, gmail_imports, gmail_import_attachments) added in
%% migrations e046c51bc5ec, 2c985d8c78fb, 13e2a56a8a32, a7c19d4e2b61. Gmail status columns have no CHECK constraints.
%% Cardinality note: ORM relationships and FK ondelete shown in relationship labels.
erDiagram
    users {
        uuid id PK
        string email UK "String(320)"
        string password_hash "argon2"
        string full_name
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
    }
    organizations {
        uuid id PK
        string name
        string slug UK
        timestamptz created_at
        timestamptz updated_at
    }
    memberships {
        uuid id PK
        uuid organization_id FK "UK with user_id"
        uuid user_id FK "UK with organization_id"
        string role "CHECK owner, admin, member"
        timestamptz created_at
    }
    documents {
        uuid id PK
        uuid organization_id FK "indexed"
        uuid created_by_user_id FK "nullable"
        string name
        timestamptz created_at
        timestamptz updated_at
    }
    document_versions {
        uuid id PK
        uuid document_id FK "UK with version_number"
        uuid uploaded_by_user_id FK "nullable"
        int version_number "CHECK greater than 0"
        string original_filename
        string content_type
        bigint size_bytes
        string storage_object_key UK
        string sha256
        string ingestion_status "pending, processing, completed, failed"
        timestamptz created_at
    }
    chunks {
        uuid id PK
        uuid document_version_id FK "UK with chunk_index"
        int chunk_index
        text text "GIN index to_tsvector simple"
        string element_type
        jsonb source_element_indexes
        jsonb metadata
        int character_count
        int token_count
        timestamptz created_at
    }
    chunk_embeddings {
        uuid id PK
        uuid chunk_id FK "UK with model"
        string model "UK with chunk_id"
        int dimension "CHECK = 1024"
        vector1024 embedding "no ANN index"
        timestamptz created_at
    }
    conversations {
        uuid id PK
        uuid organization_id FK
        uuid created_by_user_id FK
        string title "max 200"
        timestamptz created_at
        timestamptz updated_at
    }
    messages {
        uuid id PK
        uuid conversation_id FK
        string role "CHECK user, assistant"
        text content
        jsonb sources "nullable source snapshot"
        timestamptz created_at
    }
    evaluation_datasets {
        uuid id PK
        uuid organization_id FK
        uuid created_by_user_id FK "nullable"
        string name
        text description
        timestamptz created_at
        timestamptz updated_at
    }
    evaluation_cases {
        uuid id PK
        uuid dataset_id FK "UK with position"
        int position
        text question
        text reference_answer
        jsonb relevant_document_ids "UUID strings, not an FK"
        jsonb metadata
        timestamptz created_at
        timestamptz updated_at
    }
    evaluation_runs {
        uuid id PK
        uuid dataset_id FK
        uuid started_by_user_id FK "nullable"
        string status "pending, running, completed, failed"
        int total_cases
        int completed_cases
        int failed_cases
        jsonb metrics "aggregates"
        text error_message
        timestamptz started_at
        timestamptz completed_at
        timestamptz created_at
    }
    evaluation_results {
        uuid id PK
        uuid run_id FK "UK with case_id"
        uuid case_id FK "nullable"
        text question_snapshot
        text reference_answer_snapshot
        jsonb case_metadata_snapshot
        text actual_answer
        jsonb retrieved_sources
        jsonb metrics
        text status "completed, failed"
        text error_message
        int duration_ms
        timestamptz created_at
    }

    gmail_connections {
        uuid id PK
        uuid user_id FK "indexed; CASCADE"
        uuid organization_id FK "indexed; CASCADE"
        string google_email "max 320"
        string encrypted_refresh_token "encrypted; max 2048"
        string scopes "max 1000"
        string status "default active; max 30"
        timestamptz created_at
        timestamptz updated_at
        timestamptz last_used_at "nullable"
        %% Constraint: UNIQUE(user_id, organization_id)
    }
    gmail_oauth_states {
        string state_hash PK "SHA-256 hex digest; length 64"
        uuid user_id FK "indexed; CASCADE"
        uuid organization_id FK "indexed; CASCADE"
        timestamptz expires_at "indexed"
        timestamptz consumed_at "nullable"
        timestamptz created_at
    }
    gmail_imports {
        uuid id PK
        uuid gmail_connection_id FK "indexed; CASCADE"
        uuid organization_id FK "indexed; CASCADE"
        string gmail_message_id "max 512"
        string sender "nullable; max 1000"
        string subject "nullable; max 1000"
        string message_date "nullable; max 255"
        string status "default pending; max 30"
        uuid document_id FK "nullable; indexed; SET NULL"
        text error_message "nullable"
        timestamptz created_at
        timestamptz updated_at
        %% Constraint: UNIQUE(gmail_connection_id, gmail_message_id)
    }
    gmail_import_attachments {
        uuid id PK
        uuid gmail_import_id FK "indexed; CASCADE"
        string gmail_attachment_id "max 512"
        string filename "max 255"
        string content_type "nullable; max 255"
        int size_bytes "nullable"
        string status "default pending; max 30"
        uuid document_id FK "nullable; indexed; SET NULL"
        text error_message "nullable"
        timestamptz created_at
        timestamptz updated_at
        %% Constraint: UNIQUE(gmail_import_id, gmail_attachment_id)
    }
    users ||--o{ memberships : "CASCADE"
    organizations ||--o{ memberships : "CASCADE"
    organizations ||--o{ documents : "CASCADE"
    users |o--o{ documents : "created_by, no DB ondelete, app nulls it"
    documents ||--o{ document_versions : "CASCADE"
    users |o--o{ document_versions : "uploaded_by, no DB ondelete, app nulls it"
    document_versions ||--o{ chunks : "CASCADE"
    chunks ||--o{ chunk_embeddings : "CASCADE"
    organizations ||--o{ conversations : "CASCADE"
    users ||--o{ conversations : "CASCADE"
    conversations ||--o{ messages : "CASCADE"
    organizations ||--o{ evaluation_datasets : "CASCADE"
    users |o--o{ evaluation_datasets : "SET NULL"
    evaluation_datasets ||--o{ evaluation_cases : "CASCADE"
    evaluation_datasets ||--o{ evaluation_runs : "CASCADE"
    users |o--o{ evaluation_runs : "SET NULL"
    users ||--o{ gmail_connections : "CASCADE"
    organizations ||--o{ gmail_connections : "CASCADE"
    users ||--o{ gmail_oauth_states : "CASCADE"
    organizations ||--o{ gmail_oauth_states : "CASCADE"
    gmail_connections ||--o{ gmail_imports : "CASCADE"
    organizations ||--o{ gmail_imports : "CASCADE"
    gmail_imports ||--o{ gmail_import_attachments : "CASCADE"
    documents |o--o{ gmail_imports : "SET NULL"
    documents |o--o{ gmail_import_attachments : "SET NULL"
    evaluation_runs ||--o{ evaluation_results : "CASCADE"
    evaluation_cases |o--o{ evaluation_results : "SET NULL"
