APP_NAME=DocPilot API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://docpilot:change-me@localhost:5433/docpilot

# Generate with cryptography. Keep the key secret and stable.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth client settings (keep real credentials in .env only).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/gmail/oauth/callback
